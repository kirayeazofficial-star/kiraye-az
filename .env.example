# Use the public origin of the website; rebuild when changing this value.
NEXT_PUBLIC_SITE_URL=https://kirayeal.az
# Used by Docker Compose/Caddy. No scheme, path or trailing slash.
SITE_HOST=kirayeal.az

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ or expose in browser scripts.
# Host backend. Keep these server-side and empty until the
# PostgreSQL database/user have been created in cPanel.
KIRAYE_BACKEND=host
KIRAYE_DB_HOST=
KIRAYE_DB_PORT=5432
KIRAYE_DB_NAME=
KIRAYE_DB_USER=
KIRAYE_DB_PASSWORD=
KIRAYE_SESSION_SECRET=
KIRAYE_STORAGE_ROOT=
KIRAYE_SMTP_HOST=
KIRAYE_SMTP_PORT=465
KIRAYE_SMTP_USER=
KIRAYE_SMTP_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
