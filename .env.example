NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Use the public origin of the website; rebuild when changing this or Supabase values.
NEXT_PUBLIC_SITE_URL=https://kirayeal.az
# Used by Docker Compose/Caddy. No scheme, path or trailing slash.
SITE_HOST=kirayeal.az

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ or expose in browser scripts.
# Required together with supabase/recovery-check.sql for exact recovery lookup.
SUPABASE_SERVICE_ROLE_KEY=
