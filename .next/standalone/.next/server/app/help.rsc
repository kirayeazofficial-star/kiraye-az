13:["$","section","Kirayəni necə razılaşdırım?",{"className":"helpCard","children":[["$","h2",null,{"children":"Kirayəni necə razılaşdırım?"}],["$","p",null,{"children":"Elan səhifəsində zəng və ya WhatsApp düyməsi ilə sahibinə müraciət et. Tarix, depozit, qaytarılma və zərərə görə məsuliyyəti yazılı dəqiqləşdir."}]]}]
14:["$","section","Kirayə xərcini necə hesablayım?",{"className":"helpCard","children":[["$","h2",null,{"children":"Kirayə xərcini necə hesablayım?"}],["$","p",null,{"children":"Elan səhifəsində götürmə və qaytarma tarixlərini seç. Günlük qiymət gün sayına, aylıq qiymət təqvim aylarının sayına vurulur. Depozit ayrıca göstərilir. Çatdırılma təklif edilirsə, seçə bilərsən. Haqqı yazılmayıbsa, sahibindən dəqiqləşdir. Kommunal və digər əlavə xərcləri də ayrıca razılaşdır."}]]}]
15:["$","section","Tarix seçmək rezervasiya yaradır?",{"className":"helpCard","children":[["$","h2",null,{"children":"Tarix seçmək rezervasiya yaradır?"}],["$","p",null,{"children":"Xeyr. Hesablama tarixləri tutmur. Mövcudluğu və son qiyməti elan sahibi təsdiqləməlidir. Depozitin qaytarılması, gecikmə, zərər və ləğv şərtlərini əvvəlcədən yazılı razılaşdır."}]]}]
16:["$","section","Saytda ödəniş edə bilərəm?",{"className":"helpCard","children":[["$","h2",null,{"children":"Saytda ödəniş edə bilərəm?"}],["$","p",null,{"children":"Xeyr. Platforma ödəniş və rezervasiya qəbul etmir. Elan sahibi ilə birbaşa razılaşırsan. Əmlakı görmədən beh göndərmə."}]]}]
17:["$","section","Şübhəli elanı necə bildirim?",{"className":"helpCard","children":[["$","h2",null,{"children":"Şübhəli elanı necə bildirim?"}],["$","p",null,{"children":"Elanın ünvanını və səbəbi telefon, WhatsApp və ya e-poçtla bizə göndər. Elan yoxlanılacaq."}]]}]
