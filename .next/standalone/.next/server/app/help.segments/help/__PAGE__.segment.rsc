15:["$","p",null,{"children":"Elan səhifəsində zəng və ya WhatsApp düyməsi ilə sahibinə müraciət et. Tarix, depozit, qaytarılma və zərərə görə məsuliyyəti yazılı dəqiqləşdir."}]
16:["$","section","Kirayə xərcini necə hesablayım?",{"className":"helpCard","children":[["$","h2",null,{"children":"Kirayə xərcini necə hesablayım?"}],["$","p",null,{"children":"Elan səhifəsində götürmə və qaytarma tarixlərini seç. Günlük qiymət gün sayına, aylıq qiymət təqvim aylarının sayına vurulur. Depozit ayrıca göstərilir. Çatdırılma təklif edilirsə, seçə bilərsən. Haqqı yazılmayıbsa, sahibindən dəqiqləşdir. Kommunal və digər əlavə xərcləri də ayrıca razılaşdır."}]]}]
17:["$","section","Tarix seçmək rezervasiya yaradır?",{"className":"helpCard","children":[["$","h2",null,{"children":"Tarix seçmək rezervasiya yaradır?"}],["$","p",null,{"children":"Xeyr. Hesablama və WhatsApp müraciəti tarixləri tutmur. Mövcudluğu və son qiyməti elan sahibi təsdiqləməlidir. Depozitin qaytarılması, gecikmə, zərər və ləğv şərtlərini əvvəlcədən yazılı razılaşdır."}]]}]
18:["$","section","Saytda ödəniş edə bilərəm?",{"className":"helpCard","children":[["$","h2",null,{"children":"Saytda ödəniş edə bilərəm?"}],["$","p",null,{"children":"Kirayə ödənişi saytda edilmir, elan sahibi ilə birbaşa razılaşırsan. Əmlakı görmədən beh göndərmə. Yalnız reklam xidmətləri (VIP, Premium, İrəli çək) şəxsi hesabın balansından ödənilir."}]]}]
19:["$","section","Şübhəli elanı necə bildirim?",{"className":"helpCard","children":[["$","h2",null,{"children":"Şübhəli elanı necə bildirim?"}],["$","p",null,{"children":"Elan səhifəsində “Bu elandan şikayət et” seç. Hesabına daxil olub səbəbi və qısa təsviri yaz. İdarəçi şikayəti yoxlayacaq."}]]}]
1a:["$","section","Hesabıma necə daxil olum?",{"className":"helpCard","children":[["$","h2",null,{"children":"Hesabıma necə daxil olum?"}],["$","p",null,{"children":"“Daxil ol” bölməsində qeydiyyatdan keçdiyin e-poçt ünvanını və şifrəni yaz. Hesabın yoxdursa, “Qeydiyyatdan keç” seç. Şifrəni unutmusansa, “Şifrəni unutdum” ilə bərpa et."}]]}]
1b:["$","section","Təsdiq məktubu gəlmir?",{"className":"helpCard","children":[["$","h2",null,{"children":"Təsdiq məktubu gəlmir?"}],["$","p",null,{"children":"Spam qovluğunu yoxla. Giriş səhifəsində yeni təsdiq məktubu istə. Yalnız ən son link və ya məktubdakı koddan istifadə et."}]]}]
