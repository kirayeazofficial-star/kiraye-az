8:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[[["$","$Le",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"KİRAYƏ ÜÇÜN BƏLƏDÇİ"}],["$","h1",null,{"children":"Sualınız var? Buradan başlayın."}],["$","$Lf",null,{}],["$","div",null,{"className":"helpGrid","children":[["$","details","Elan necə yerləşdirilir?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Elan necə yerləşdirilir?"}]}],["$","p",null,{"children":"Hesabınıza daxil olun, şəkilləri və kirayə şərtlərini əlavə edin. Elan yoxlamadan keçdikdən sonra yayımlanır."}]]}],["$","details","Elanımı necə dəyişə bilərəm?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Elanımı necə dəyişə bilərəm?"}]}],["$","p",null,{"children":"Şəxsi kabinetdə “Redaktə et” düyməsini seçin. Elanı 24 saat ərzində ən çox 2 dəfə redaktə etmək mümkündür. Dəyişikliklər yenidən yoxlamaya göndərilir. Aktual olmayan elanı silə bilərsiniz."}]]}],["$","details","Kirayəni necə razılaşdırım?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Kirayəni necə razılaşdırım?"}]}],["$","p",null,{"children":"Elan səhifəsində zəng, mesaj və ya WhatsApp düyməsi ilə elan sahibinə müraciət edin. Tarixləri, depoziti, qaytarılma şərtlərini və zərərə görə məsuliyyəti yazılı şəkildə razılaşdırın."}]]}],["$","details","Kirayə xərcini necə hesablayım?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Kirayə xərcini necə hesablayım?"}]}],["$","p",null,{"children":"Elan səhifəsində götürmə və qaytarma tarixlərini seçin. Günlük qiymət gün sayına, aylıq qiymət təqvim aylarının sayına uyğun hesablanır. Depozit ayrıca göstərilir. Çatdırılma, kommunal və digər əlavə xərcləri elan sahibi ilə dəqiqləşdirin."}]]}],["$","details","Tarix seçmək rezervasiya yaradır?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Tarix seçmək rezervasiya yaradır?"}]}],["$","p",null,{"children":"Xeyr. Qiymətin hesablanması və WhatsApp müraciəti rezervasiya yaratmır. Mövcudluğu və yekun qiyməti elan sahibi təsdiqləyir. Depozitin qaytarılması, gecikmə, zərər və ləğv şərtlərini əvvəlcədən yazılı razılaşdırın."}]]}],["$","details","Saytda ödəniş edə bilərəm?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Saytda ödəniş edə bilərəm?"}]}],["$","p",null,{"children":"Hazırda platformada kirayə üzrə ödəniş və rezervasiya qəbul edilmir. Elan sahibi ilə birbaşa razılaşın. Əmlakı və ya əşyanı görmədən beh göndərməyin."}]]}],["$","details","Şübhəli elanı necə bildirim?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Şübhəli elanı necə bildirim?"}]}],["$","p",null,{"children":"Elan səhifəsində “Bu elandan şikayət et” düyməsini seçin. Hesabınıza daxil olun, səbəbi və qısa təsviri yazın. Şikayət idarəçi tərəfindən araşdırılacaq."}]]}],["$","details","Hesabıma necə daxil olum?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Hesabıma necə daxil olum?"}]}],["$","p",null,{"children":"“Daxil ol” bölməsində e-poçt ünvanınızı və şifrənizi daxil edin. Hesabınız yoxdursa, “Qeydiyyat” bölməsini seçin. Şifrənizi bərpa etmək üçün “Şifrəni unutmusunuz?” keçidindən istifadə edin."}]]}],["$","details","Təsdiq məktubu gəlmir?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Təsdiq məktubu gəlmir?"}]}],["$","p",null,{"children":"“Spam” qovluğunu yoxlayın. Giriş səhifəsində “Təsdiq kodunu yenidən göndər” düyməsindən istifadə edin. Yalnız ən son göndərilmiş məktubdakı kodu daxil edin."}]]}]]}],["$","$L10",null,{"className":"add kzIconBtn","href":"/new","children":[["$","$L11",null,{"icon":{"name":"plus","size":24,"node":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"M12 5v14","key":"s699le"}]]},"aria-hidden":"true","size":18,"strokeWidth":2.25}],"Elan yerləşdir"]}]]}],"$L12"],null,"$L13"]}],"p":"$@14","v":null,"s":"$7"}}]]
