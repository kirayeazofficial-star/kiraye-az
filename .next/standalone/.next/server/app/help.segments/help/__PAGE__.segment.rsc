8:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[[["$","$Le",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"KİRAYƏ ÜÇÜN BƏLƏDÇİ"}],["$","h1",null,{"children":"Sualınız var? Buradan başlayın."}],["$","div",null,{"className":"helpGrid","children":[["$","details","Elan necə yerləşdirilir?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Elan necə yerləşdirilir?"}]}],["$","p",null,{"children":"Hesabınıza daxil olun, kateqoriyanı seçin, şəkilləri və kirayə şərtlərini əlavə edin. Elan yoxlamadan sonra yayımlanır."}]]}],["$","details","Elanımı necə dəyişə bilərəm?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Elanımı necə dəyişə bilərəm?"}]}],["$","p",null,{"children":"Şəxsi kabinetdə «Redaktə et» düyməsini seçin. Elanı 24 saat ərzində ən çox 2 dəfə redaktə etmək olar, dəyişikliklər yenidən yoxlamaya göndərilir. Aktual olmayan elanı silə bilərsiniz."}]]}],["$","details","Kirayəni necə razılaşdırım?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Kirayəni necə razılaşdırım?"}]}],["$","p",null,{"children":"Elan səhifəsində zəng və ya WhatsApp düyməsi ilə elan sahibinə müraciət edin. Tarixi, depoziti, qaytarılmanı və zərərə görə məsuliyyəti yazılı şəkildə dəqiqləşdirin."}]]}],["$","details","Kirayə xərcini necə hesablayım?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Kirayə xərcini necə hesablayım?"}]}],["$","p",null,{"children":"Elan səhifəsində götürmə və qaytarma tarixlərini seçin. Günlük qiymət gün sayına, aylıq qiymət ayların sayına vurulur. Depozit ayrıca göstərilir. Çatdırılma və kommunal kimi əlavə xərcləri elan sahibi ilə dəqiqləşdirin."}]]}],["$","details","Tarix seçmək rezervasiya yaradır?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Tarix seçmək rezervasiya yaradır?"}]}],["$","p",null,{"children":"Xeyr. Hesablama tarixləri tutmur. Mövcudluğu və son qiyməti elan sahibi təsdiqləməlidir."}]]}],["$","details","Saytda ödəniş edə bilərəm?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Saytda ödəniş edə bilərəm?"}]}],["$","p",null,{"children":"Kirayə haqqını sayt qəbul etmir, elan sahibi ilə birbaşa razılaşırsınız. Əşyanı və ya əmlakı görmədən beh göndərməyin."}]]}],["$","details","Şübhəli elanı necə bildirim?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Şübhəli elanı necə bildirim?"}]}],["$","p",null,{"children":"Elan səhifəsində «Şikayət et» düyməsini seçin, səbəbi və qısa izahı yazın. Şikayəti administrasiya yoxlayacaq."}]]}],["$","details","Hesabıma necə daxil olum?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Hesabıma necə daxil olum?"}]}],["$","p",null,{"children":"«Daxil ol» bölməsində e-poçt ünvanınızı və şifrənizi yazın. Hesabınız yoxdursa, «Qeydiyyat» seçin. Şifrəni unutmusunuzsa, «Şifrəni unutdum» ilə bərpa edin."}]]}],["$","details","Təsdiq məktubu gəlmir?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Təsdiq məktubu gəlmir?"}]}],["$","p",null,{"children":"Spam qovluğunu yoxlayın. Giriş səhifəsində yeni kod istəyin və yalnız ən son məktubdakı koddan istifadə edin."}]]}]]}],["$","$Lf",null,{}]]}],["$","$L10",null,{}]],null,["$","$L11",null,{"children":["$","$12",null,{"name":"Next.MetadataOutlet","children":"$@13"}]}]]}],"p":"$@14","v":null,"s":"$7"}}]]
