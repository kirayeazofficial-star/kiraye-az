1a:["$","details","Şübhəli elanı necə bildirim?",{"className":"helpCard","children":[["$","summary",null,{"children":["$","h2",null,{"children":"Şübhəli elanı necə bildirim?"}]}],["$","p",null,{"children":"Elan səhifəsində “Bu elandan şikayət et” seç. Hesabına daxil olub səbəbi və qısa təsviri yaz. İdarəçi şikayəti yoxlayacaq."}]]}]
