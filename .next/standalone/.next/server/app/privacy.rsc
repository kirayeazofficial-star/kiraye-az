12:[["children",{"s":"__PAGE__","h":512,"d":{"r":["$","$1","c",{"children":[[["$","$Ld",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"ŞƏXSİ MƏLUMATLAR"}],["$","h1",null,{"children":"Məlumatların necə istifadə olunur?"}],["$","h2",null,{"children":"Hesab və əlaqə"}],["$","p",null,{"children":"Hesab yaratmaq üçün e-poçt ünvanı istifadə olunur. Şifrə serverdə yalnız şifrələnmiş (hash) şəkildə saxlanılır. Profil adı və telefon nömrəsi hesabında saxlanır. Elana ayrıca yazdığın əlaqə nömrəsi, təsvir və şəkillər açıq göstərilir."}],["$","h2",null,{"children":"Şəkillər və elanlar"}],["$","p",null,{"children":"Yüklənən şəkillər açıq saxlama ünvanında yerləşir və elan təsdiqlənməmişdən əvvəl də həmin ünvanı bilənlərə görünə bilər. Şəxsi sənəd, bank kartı və üçüncü şəxslərin razılıqsız məlumatlarını yükləmə. Elanı arxivləşdirmək onu açıq axtarışdan çıxarır; bu əməliyyat bütün saxlanmış şəkilləri və hesab məlumatlarını silmir."}],["$","h2",null,{"children":"Brauzerdə saxlanan məlumat"}],["$","p",null,{"children":"Giriş sessiyası və seçilmiş elanların siyahısı brauzerdə saxlanır. Seçilmişlər cihazlar arasında avtomatik ötürülmür. Hesabdan çıxmaq sessiyanı bitirir; ortaq cihazda işi bitirəndə hesabdan çıx."}],"$L13","$L14"]}],"$L15"],null,"$L16"]}],"p":false,"v":null}}]]
