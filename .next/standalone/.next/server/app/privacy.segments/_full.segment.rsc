1c:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://kirayeal.az/#organization\",\"name\":\"kirayeal.az\",\"alternateName\":[\"Kirayə Al\",\"Kiraye Al\",\"kirayeal\"],\"url\":\"https://kirayeal.az\",\"logo\":\"https://kirayeal.az/icon-192.png\",\"email\":\"kirayeal.az@gmail.com\",\"sameAs\":[\"https://www.instagram.com/kirayeal.az/\",\"https://www.tiktok.com/@kirayeal.az\"]},{\"@type\":\"WebSite\",\"@id\":\"https://kirayeal.az/#website\",\"name\":\"kirayeal.az\",\"alternateName\":[\"Kirayə Al\",\"Kiraye Al az\"],\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://kirayeal.az/?q={search_term_string}#elanlar\",\"query-input\":\"required name=search_term_string\"},\"url\":\"https://kirayeal.az\",\"inLanguage\":\"az-AZ\",\"publisher\":{\"@id\":\"https://kirayeal.az/#organization\"}}]}"}}]
