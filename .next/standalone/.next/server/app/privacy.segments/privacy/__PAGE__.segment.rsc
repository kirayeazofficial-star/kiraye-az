1a:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[[["$","$L11",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"ŞƏXSİ MƏLUMATLAR"}],["$","h1",null,{"children":"Məlumatların necə istifadə olunur?"}],["$","h2",null,{"children":"Hesab və əlaqə"}],["$","p",null,{"children":"Hesab yaratmaq üçün e-poçt ünvanı istifadə olunur. Şifrə serverdə yalnız şifrələnmiş (hash) şəkildə saxlanılır. Profil adı və telefon nömrəsi hesabında saxlanır. Elana ayrıca yazdığın əlaqə nömrəsi, təsvir və şəkillər açıq göstərilir."}],["$","h2",null,{"children":"Şəkillər və elanlar"}],["$","p",null,{"children":"Yüklənən şəkillər açıq saxlama ünvanında yerləşir və elan təsdiqlənməmişdən əvvəl də həmin ünvanı bilənlərə görünə bilər. Şəxsi sənəd, bank kartı və üçüncü şəxslərin razılıqsız məlumatlarını yükləmə. Elanı sildikdə o, saytdan və hesabından həmişəlik götürülür; hesab məlumatların silinmir."}],["$","h2",null,{"children":"Brauzerdə saxlanan məlumat"}],["$","p",null,{"children":"Giriş sessiyası və seçilmiş elanların siyahısı brauzerdə saxlanır. Seçilmişlər cihazlar arasında avtomatik ötürülmür. Hesabdan çıxmaq sessiyanı bitirir; ortaq cihazda işi bitirəndə hesabdan çıx."}],["$","h2",null,{"children":"Şikayətlər"}],["$","p",null,{"children":"Şikayətə aid hesab identifikatoru, səbəb və mətn yoxlama üçün saxlanır. Şikayəti özün və idarəçilər görə bilər; başqa istifadəçilərə açıq deyil. Şikayət mətninə həssas məlumat əlavə etmə."}]]}],["$","$L1b",null,{}]],null,["$","$L1c",null,{"children":"$L1d"}]]}],"p":"$@1e","v":null,"s":"$16"}}]]
