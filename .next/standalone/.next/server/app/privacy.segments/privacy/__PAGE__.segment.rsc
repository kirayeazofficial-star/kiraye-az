15:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[[["$","$Ld",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"ŞƏXSİ MƏLUMATLAR"}],["$","h1",null,{"children":"Məlumatların necə istifadə olunur?"}],["$","h2",null,{"children":"Hesab və əlaqə"}],["$","p",null,{"children":"Saytda istifadəçi hesabı və giriş yoxdur. Elan yerləşdirmək üçün bizimlə əlaqə saxladıqda verdiyin ad, telefon və e-poçt yalnız elanı hazırlamaq və səninlə əlaqə saxlamaq üçün istifadə olunur. Elanda göstərilən əlaqə nömrəsi, təsvir və şəkillər hamıya açıq görünür."}],["$","h2",null,{"children":"Şəkillər və elanlar"}],["$","p",null,{"children":"Elanda yerləşdirilən şəkillər və mətn açıq görünür. Şəxsi sənəd, bank kartı və üçüncü şəxslərin razılıqsız məlumatlarını göndərmə. Elanı götürmək istəsən, bizimlə əlaqə saxla."}],["$","h2",null,{"children":"Brauzerdə saxlanan məlumat"}],["$","p",null,{"children":"Seçilmiş elanların siyahısı, saxlanmış axtarışlar, axtarış tarixçəsi və dil seçimi yalnız sənin brauzerində saxlanır və cihazlar arasında ötürülmür. Brauzerin məlumatlarını təmizləməklə onları silə bilərsən."}],["$","h2",null,{"children":"Şikayətlər"}],["$","p",null,{"children":"Şikayət göndərdikdə yazdığın məlumat yalnız şikayəti araşdırmaq üçün istifadə olunur. Şikayətə həssas məlumat əlavə etmə."}]]}],["$","$L16",null,{}]],null,["$","$L17",null,{"children":["$","$18",null,{"name":"Next.MetadataOutlet","children":"$@19"}]}]]}],"p":"$@1a","v":null,"s":"$11"}}]]
