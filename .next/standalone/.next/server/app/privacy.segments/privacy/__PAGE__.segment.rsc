8:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[[["$","$Le",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"ŞƏXSİ MƏLUMATLAR"}],["$","h1",null,{"children":"Məxfilik siyasəti"}],["$","p",null,{"children":"Son yeniləmə: 7 noyabr 2026"}],["$","h2",null,{"children":"Hesab və əlaqə məlumatları"}],["$","p",null,{"children":"Hesab yaratmaq üçün ad, e-poçt ünvanı və telefon nömrəsi istifadə olunur. Şifrə serverdə yalnız şifrələnmiş (hash) şəkildə saxlanılır və heç kimə, o cümlədən administrasiyaya görünmür. Profil şəkli istəyə bağlıdır. Elanda göstərdiyiniz əlaqə nömrəsi, təsvir və şəkillər hamıya açıq görünür."}],["$","h2",null,{"children":"Elanlar və şəkillər"}],["$","p",null,{"children":"Yüklənən şəkillər saytın serverində saxlanılır. Şəxsi sənəd, bank kartı və üçüncü şəxslərin razılığı olmadan onların məlumatlarını yükləməyin. Silinən, müddəti bitən və ya rədd edilən elan saytda görünmür, lakin 180 gün ərzində bərpa üçün saxlanılır, sonra arxivə keçir."}],["$","h2",null,{"children":"Mesajlar"}],["$","p",null,{"children":"İstifadəçilər arasındakı mesajlar yalnız yazışmanın tərəflərinə görünür. Şikayət və ya dələduzluq şübhəsi araşdırılarkən administrasiya müvafiq yazışmaya baxa bilər."}],["$","h2",null,{"children":"E-poçt bildirişləri"}],["$","p",null,{"children":"Sayt təsdiq kodları, elanın təsdiqi və ya rəddi, yeni mesajlar haqqında xidməti məktublar göndərir. Bildirişləri profil səhifəsində söndürə bilərsiniz; təsdiq kodları hesabın təhlükəsizliyi üçün həmişə göndərilir."}],["$","h2",null,{"children":"Təhlükəsizlik"}],["$","p",null,{"children":"Hesabı qorumaq üçün giriş cəhdləri, IP ünvanı və brauzer məlumatı qısa müddət saxlanıla bilər (məsələn, şifrənin təxmin edilməsinin qarşısını almaq üçün). Bu məlumatlar başqa məqsədlə istifadə olunmur."}],["$","h2",null,{"children":"Brauzerdə saxlanan məlumat"}],["$","p",null,{"children":"Giriş sessiyası və seçilmiş elanların siyahısı brauzerinizdə saxlanılır. Seçilmişlər cihazlar arasında avtomatik ötürülmür. Hesabdan çıxdıqda sessiya bitir; ortaq cihazda işi bitirəndə hesabdan çıxın."}],["$","h2",null,{"children":"Şikayətlər"}],["$","p",null,{"children":"Şikayətə aid hesab identifikatoru, səbəb və mətn yoxlama üçün saxlanılır. Şikayəti yalnız siz və administrasiya görür. Şikayət mətninə həssas məlumat əlavə etməyin."}],["$","h2",null,{"children":"Məlumatların ötürülməsi"}],["$","p",null,{"children":"E-poçt ünvanınız və telefon nömrəniz reklam məqsədilə üçüncü şəxslərə verilmir. Qanunla tələb olunduqda məlumatlar səlahiyyətli dövlət orqanlarına təqdim edilə bilər."}],["$","h2",null,{"children":"Əlaqə"}],["$","p",null,{"children":"Məlumatlarınızla bağlı sual və ya hesabın silinməsi üçün kirayeal.az@gmail.com ünvanına yazın."}],["$","p",null,{"children":[["$","$Lf",null,{"href":"/terms","children":"İstifadəçi razılaşması"}]," · ",["$","$Lf",null,{"href":"/rules","children":"Elan yerləşdirmə qaydaları"}]]}]]}],["$","$L10",null,{}]],null,["$","$L11",null,{"children":["$","$12",null,{"name":"Next.MetadataOutlet","children":"$@13"}]}]]}],"p":"$@14","v":null,"s":"$7"}}]]
