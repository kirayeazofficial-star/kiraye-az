8:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[[["$","$Le",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"ŞƏXSİ MƏLUMATLAR"}],["$","h1",null,{"children":"Məlumatlarınız necə istifadə olunur?"}],[["$","section","Hesab və əlaqə",{"children":[["$","h2",null,{"children":"Hesab və əlaqə"}],["$","p",null,{"children":"Hesab yaratmaq üçün e-poçt ünvanından istifadə olunur. Şifrəniz açıq mətnlə saxlanılmır; serverdə heş formasında saxlanılır. Profil adınız və telefon nömrəniz hesabınızda saxlanılır. Elana əlavə etdiyiniz əlaqə nömrəsi, mətn və şəkillər ictimai yayımlanır."}]]}],["$","section","Şəkillər və elanlar",{"children":[["$","h2",null,{"children":"Şəkillər və elanlar"}],["$","p",null,{"children":"Yüklənən şəkillər açıq saxlama ünvanında yerləşir və elan təsdiqlənməmişdən əvvəl də həmin ünvanı bilən şəxslərə görünə bilər. Şəxsi sənədləri, bank kartı məlumatlarını və üçüncü şəxslərin razılıqsız məlumatlarını yükləməyin."}]]}],["$","section","Elanın silinməsi",{"children":[["$","h2",null,{"children":"Elanın silinməsi"}],["$","p",null,{"children":"Elanı sildikdə elan ictimai yayımdan çıxarılır və kabinetin “Silinmiş” bölməsinə keçirilir. Bu, məlumatların dərhal və həmişəlik silinməsi demək deyil. Bərpa saytın qüvvədə olan şərtlərinə uyğun mümkündür. Silinmiş və fəaliyyətsiz elanlar 180 gündən sonra kabinet siyahısında göstərilmir."}]]}],["$","section","Brauzerdə saxlanan məlumat",{"children":[["$","h2",null,{"children":"Brauzerdə saxlanan məlumat"}],["$","p",null,{"children":"Giriş sessiyası və seçilmiş elanların siyahısı brauzerdə saxlanılır. Seçilmişlər cihazlar arasında avtomatik ötürülmür. Hesabdan çıxış sessiyanı bitirir. Ortaq cihazdan istifadəni tamamladıqda hesabınızdan çıxın."}]]}],["$","section","Elan qaralamaları",{"children":[["$","h2",null,{"children":"Elan qaralamaları"}],["$","p",null,{"children":"Yarımçıq elanın mətni, seçilmiş şəkilləri və yerləşmə məlumatları qaralamanı bərpa etmək üçün bu cihazın brauzerində saxlanıla bilər. Şəkillər saxlanıla bilmədikdə yalnız mətn saxlanılır və bu barədə məlumat göstərilir. 7 gündən köhnə qaralamalar bərpa üçün təklif edilmir. Qaralamanı elan yerləşdirmə səhifəsində silə bilərsiniz."}]]}],["$","section","Şikayətlər",{"children":[["$","h2",null,{"children":"Şikayətlər"}],["$","p",null,{"children":"Şikayətə aid hesab identifikatoru, səbəb və mətn araşdırma üçün saxlanılır. Bu məlumatlar şikayəti göndərən şəxsə və idarəçilərə aiddir, digər istifadəçilərə açıq deyil. Şikayət mətninə həssas məlumat əlavə etməyin."}]]}]]]}],["$","$Lf",null,{}]],null,["$","$L10",null,{"children":["$","$11",null,{"name":"Next.MetadataOutlet","children":"$@12"}]}]]}],"p":"$@13","v":null,"s":"$7"}}]]
