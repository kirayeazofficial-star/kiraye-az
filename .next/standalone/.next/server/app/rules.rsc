}],["$","p",null,{"children":"Keçid dəyişmiş və ya səhifə silinmiş ola bilər."}],["$","$Le",null,{"className":"add","href":"/","children":"Elanlara qayıt"}]]}]}]],[]],"forbidden":"$undefined","unauthorized":"$undefined"}]}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://kirayeal.az/#organization\",\"name\":\"kirayeal.az\",\"url\":\"https://kirayeal.az\",\"logo\":\"https://kirayeal.az/icon-192.png\",\"email\":\"kirayeal.az@gmail.com\",\"telephone\":\"+994502191145\",\"sameAs\":[\"https://www.instagram.com/kirayeal.az/\",\"https://www.tiktok.com/@kirayeal.az\"]},{\"@type\":\"WebSite\",\"@id\":\"https://kirayeal.az/#website\",\"name\":\"kirayeal.az\",\"url\":\"https://kirayeal.az\",\"inLanguage\":\"az-AZ\",\"publisher\":{\"@id\":\"https://kirayeal.az/#organization\"}}]}"}}]]}]}]]}],"p":false,"v":null},"c":"$Qf"},"h":{"r":["$","$1","h",{"children":[null,["$","$L17",null,{"children":"$L18"}],["$","$L1a",null,{"children":[["$","div",null,{"hidden":true,"children":["$","$14",null,{"name":"Next.Metadata","children":"$L1b"}]}],null]}],null]}],"p":false,"v":null}},"m":"$undefined","G":["$1c",[]],"S":true,"r":"$undefined","s":"$undefined","a":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"dFlxiPJOwE0GD3vd11Qs1"}
