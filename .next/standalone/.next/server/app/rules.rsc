1d:["$","h2",null,{"children":[5,". ","Şəkillər və əlaqə məlumatları"]}]
1e:["$","p","0",{"children":[["$","strong",null,{"children":[5,".",1,"."]}]," ","Elana əşyanı aydın göstərən 1–6 real şəkil əlavə et. JPG, PNG və WebP qəbul olunur; hər şəkil maksimum 5 MB ola bilər. Başqasının şəkillərindən icazəsiz istifadə etmə."]}]
1f:["$","p","1",{"children":[["$","strong",null,{"children":[5,".",2,"."]}]," ","İşlək e-poçt və istifadəsinə icazən olan telefon nömrəsi göstər. Əlaqə məlumatlarını bunun üçün ayrılmış xanalarda yaz; başqasına narahatlıq yaratmaq məqsədilə onun nömrəsini yerləşdirmək olmaz."]}]
20:["$","p","2",{"children":[["$","strong",null,{"children":[5,".",3,"."]}]," ","Şəxsiyyət vəsiqəsi, bank kartının həssas məlumatları, PIN/CVV, şifrə və SMS kodlarını elanda və şəkillərdə paylaşma. Hesabına giriş məlumatlarını başqasına vermə."]}]
21:["$","section","Yoxlama və şikayətlər",{"id":"qayda-6","children":[["$","h2",null,{"children":[6,". ","Yoxlama və şikayətlər"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[6,".",1,"."]}]," ","Yeni və redaktə edilmiş elanlar yoxlanılır. Qaydalara uyğun olmayan elan rədd edilə bilər; rədd səbəbi şəxsi kabinetdə göstərilir."]}],["$","p","1",{"children":[["$","strong",null,{"children":[6,".",2,"."]}]," ","Şübhəli elan barədə elan səhifəsindəki şikayət funksiyasından istifadə et. Səbəbi və araşdırmaya kömək edəcək məlumatları göstər."]}],["$","p","2",{"children":[["$","strong",null,{"children":[6,".",3,"."]}]," ","Qayda pozuntusu aşkarlandıqda düzəliş tələb oluna və ya elanın yayımı dayandırıla bilər. Təkrar və ciddi pozuntular hesabın məhdudlaşdırılması üçün əsas ola bilər."]}],["$","p","3",{"children":[["$","strong",null,{"children":[6,".",4,"."]}]," ","Şikayətə araşdırma əsasında baxılır. Qərarla razılaşmadıqda elan nömrəsini və izahını göstərərək yenidən baxılmasını istəyə bilərsən."]}]]]}]
22:["$","section","Reklam xidmətləri və ödənişlər",{"id":"qayda-7","children":[["$","h2",null,{"children":[7,". ","Reklam xidmətləri və ödənişlər"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[7,".",1,"."]}]," ","VIP, Premium və “İrəli çək” xidmətləri şəxsi hesabın balansından ödənilir və yalnız yayımlanmış elanlara tətbiq olunur. Bank kartı ilə onlayn balans artırımı hələ qoşulmayıb; balans idarəçi tərəfindən artırılır."]}],["$","p","1",{"children":[["$","strong",null,{"children":[7,".",2,"."]}]," ","Xidmətin qiyməti və müddəti ödənişdən əvvəl göstərilir; alınmış xidmət geri qaytarılmır. Reklam xidməti elan qaydalarını və yerləşdirmə limitlərini aradan qaldırmır."]}],["$","p","2",{"children":[["$","strong",null,{"children":[7,".",3,"."]}]," ","Kirayə razılaşması hazırda tərəflər arasında bağlanır. Əşyanı və qarşı tərəfi yoxlamadan beh göndərmə; qiymət, depozit, müddət, zərər və qaytarılma şərtlərini əvvəlcədən yazılı razılaşdır."]}]]]}]
23:["$","section",null,{"id":"muddet-ve-limit","children":[["$","h2",null,{"children":"8. Aktivləşdiriləcək 30 günlük müddət və limit qaydaları"}],["$","p",null,{"className":"notice","children":[["$","strong",null,{"children":"Bu hissə hələ qüvvəyə minməyib."}]," 30 günlük avtomatik müddət, bərpa sistemi və kateqoriyalar üzrə dəqiq limitlər aktivləşdirildikdə burada bildiriləcək. Ödəniş qəbul edilmir."]}],["$","p",null,{"children":[["$","strong",null,{"children":"8.1."}]," Elanın aktivlik müddəti 30 gün olacaq. Müddət başa çatdıqda yayımı dayanacaq və elan silinmədən “Müddəti başa çatmış” bölməsinə keçəcək."]}],["$","p",null,{"children":[["$","strong",null,{"children":"8.2."}]," Həm eyni vaxtda aktiv elan sayı, həm də kateqoriya üzrə 30 gün ərzində yerləşdirilən elan sayı nəzərə alınacaq. Kateqoriyalar üzrə saylar ayrıca göstəriləcək."]}],["$","p",null,{"children":[["$","strong",null,{"children":"8.3."}]," Limit aşıldıqda istifadəçi növbəti elan üçün limitin imkan verməsini gözləməli və ya ödənişli xidmətlər aktiv olduqda uyğun kateqoriya paketi seçməli olacaq."]}],["$","p",null,{"children":[["$","strong",null,{"children":"8.4."}]," İstifadəçinin sildiyi/arxivə keçirdiyi və ya müddəti bitmiş elanın bərpası ödənişli xidmətdir. Ödəniş sistemi aktivləşənədək bərpa mümkün deyil və heç bir məbləğ tutulmur. Xidmətin qiyməti aktivləşdirilməzdən əvvəl göstəriləcək."]}],["$","p",null,{"children":[["$","strong",null,{"children":"8.5."}]," Ödənişli xidmətin elan müddətini bərpa etməsi və uzatması xidmət aktivləşdiriləndə göstərilən şərtlərlə tənzimlənəcək."]}]]}]
