12:[["$","$Ld",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"QAYDALAR VƏ TƏHLÜKƏSİZLİK"}],["$","h1",null,{"children":"Elan yerləşdirmə qaydaları"}],["$","p",null,{"children":"Elan yerləşdirməzdən əvvəl qaydalarla tanış ol. Bu səhifə kirayeal.az-da elan yerləşdirmə, redaktə və təhlükəsiz istifadə şərtlərini izah edir."}],[["$","section","Ümumi şərtlər",{"id":"qayda-1","children":[["$","h2",null,{"children":[1,". ","Ümumi şərtlər"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[1,".",1,"."]}]," ","Kirayeal.az kirayə elanları platformasıdır. Yalnız sahibi olduğun və ya kirayəyə verməyə icazən olan əmlak və əşyaları yerləşdir."]}],["$","p","1",{"children":[["$","strong",null,{"children":[1,".",2,"."]}]," ","Elanın məlumatları düzgün, qanunvericiliyə uyğun və üçüncü şəxslərin hüquqlarını pozmayan olmalıdır. Saxta və qanunsuz təkliflər qəbul edilmir."]}],["$","p","2",{"children":[["$","strong",null,{"children":[1,".",3,"."]}]," ","Elanın yoxlanılması elan sahibinin etibarlılığına və əşyanın vəziyyətinə zəmanət deyil. Bu qaydalar reklam xidmətindən istifadə olunub-olunmamasından asılı olmayaraq bütün elanlara aiddir."]}]]]}],["$","section","Elanın yerləşdirilməsi",{"id":"qayda-2","children":[["$","h2",null,{"children":[2,". ","Elanın yerləşdirilməsi"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[2,".",1,"."]}]," ","Elan yerləşdirmək üçün hesabına daxil ol. Yayımlanmış elanlara qeydiyyatsız baxmaq mümkündür."]}],["$","p","1",{"children":[["$","strong",null,{"children":[2,".",2,"."]}]," ","Elanı əşyanın növünə uyğun kateqoriyada yerləşdir. Limitdən yayınmaq üçün yanlış kateqoriya seçmək olmaz."]}],["$","p","2",{"children":[["$","strong",null,{"children":[2,".",3,"."]}]," ","Elan yerləşdirməyə kateqoriya üzrə müəyyən edilən limit tətbiq olunur. Elan göndərilərkən kateqoriya üzrə limit yoxlanılır."]}],["$","p","3",{"children":[["$","strong",null,{"children":[2,".",4,"."]}]," ","Bir elan konkret əmlakı, əşyanı və ya birlikdə kirayəyə verilən dəsti təsvir etməlidir. Əlaqəsiz məhsulları bir elanda birləşdirmək olmaz."]}]]]}],["$","section","Təkrar elanlar və redaktə",{"id":"qayda-3","children":[["$","h2",null,{"children":[3,". ","Təkrar elanlar və redaktə"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[3,".",1,"."]}]," ","Eyni əmlak və ya əşya üçün təkrar aktiv və ya yoxlamada olan elan yaratma. Elanı silib yenidən yerləşdirməklə və ya başqa hesabdan istifadə etməklə limitdən yayınmaq olmaz."]}],["$","p","1",{"children":[["$","strong",null,{"children":[3,".",2,"."]}]," ","Qiymət, təsvir, şəkil və əlaqə məlumatlarında dəyişiklik üçün mövcud elanın “Redaktə et” seçimini istifadə et. Dəyişikliklər yenidən yoxlamaya göndərilir."]}],["$","p","2",{"children":[["$","strong",null,{"children":[3,".",3,"."]}]," ","Mövcud elanın məlumatlarını başqa əmlakın və ya əşyanın məlumatları ilə əvəz etmək olmaz. Redaktə elanı avtomatik irəli çəkmir."]}],["$","p","3",{"children":[["$","strong",null,{"children":[3,".",4,"."]}]," ","Artıq kirayəyə verilməyən və ya aktual olmayan elanı arxivə keçir. Arxivləşdirmə məlumatları hesabından silmir."]}]]]}],["$","section","Başlıq, qiymət və kirayə şərtləri",{"id":"qayda-4","children":[["$","h2",null,{"children":[4,". ","Başlıq, qiymət və kirayə şərtləri"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[4,".",1,"."]}]," ","Başlıq qısa, aydın və təklifə uyğun olmalıdır. Başlıqda telefon nömrəsi, reklam keçidləri, təkrarlanan açar sözlər və aldadıcı ifadələr yerləşdirmə."]}],["$","p","1",{"children":[["$","strong",null,{"children":[4,".",2,"."]}]," ","Qiyməti AZN ilə və hansı müddətə aid olduğunu göstərərək yaz. Real kirayə haqqını gizlədən şərti qiymət göstərmək olmaz."]}],["$","p","2",{"children":[["$","strong",null,{"children":[4,".",3,"."]}]," ","Depozit, minimum kirayə müddəti, çatdırılma və digər əlavə ödənişlər varsa, onları açıq qeyd et. Əşyanın məlum qüsurlarını və istifadə məhdudiyyətlərini gizlətmə."]}]]]}],["$","section","Şəkillər və əlaqə məlumatları",{"id":"qayda-5","children":["$L1d",["$L1e","$L1f","$L20"]]}],"$L21","$L22"],"$L23","$L24"]}],"$L25"]
