15:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[[["$","$Le",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"QAYDALAR VƏ TƏHLÜKƏSİZLİK"}],["$","h1",null,{"children":"Elan yerləşdirmə qaydaları"}],["$","p",null,{"children":"Elan yerləşdirməzdən əvvəl qaydalarla tanış ol. Bu səhifə kirayeal.az-da elan yerləşdirmə, redaktə və təhlükəsiz istifadə şərtlərini izah edir."}],[["$","section","Ümumi şərtlər",{"id":"qayda-1","children":[["$","h2",null,{"children":[1,". ","Ümumi şərtlər"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[1,".",1,"."]}]," ","Kirayeal.az kirayə elanları platformasıdır. Yalnız sahibi olduğun və ya kirayəyə verməyə icazən olan əmlak və əşyaları yerləşdir."]}],["$","p","1",{"children":[["$","strong",null,{"children":[1,".",2,"."]}]," ","Elanın məlumatları düzgün, qanunvericiliyə uyğun və üçüncü şəxslərin hüquqlarını pozmayan olmalıdır. Saxta və qanunsuz təkliflər qəbul edilmir."]}],["$","p","2",{"children":[["$","strong",null,{"children":[1,".",3,"."]}]," ","Elanın yoxlanılması elan sahibinin etibarlılığına və əşyanın vəziyyətinə zəmanət deyil. Bu qaydalar reklam xidmətindən istifadə olunub-olunmamasından asılı olmayaraq bütün elanlara aiddir."]}]]]}],["$","section","Elanın yerləşdirilməsi",{"id":"qayda-2","children":[["$","h2",null,{"children":[2,". ","Elanın yerləşdirilməsi"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[2,".",1,"."]}]," ","Elan yerləşdirmək üçün hesabına daxil ol. Yayımlanmış elanlara qeydiyyatsız baxmaq mümkündür."]}],["$","p","1",{"children":[["$","strong",null,{"children":[2,".",2,"."]}]," ","Elanı əşyanın növünə uyğun kateqoriyada yerləşdir. Limitdən yayınmaq üçün yanlış kateqoriya seçmək olmaz."]}],["$","p","2",{"children":[["$","strong",null,{"children":[2,".",3,"."]}]," ","Elan yerləşdirməyə kateqoriya üzrə müəyyən edilən limit tətbiq olunur. Elan göndərilərkən kateqoriya üzrə limit yoxlanılır."]}],["$","p","3",{"children":[["$","strong",null,{"children":[2,".",4,"."]}]," ","Bir elan konkret əmlakı, əşyanı və ya birlikdə kirayəyə verilən dəsti təsvir etməlidir. Əlaqəsiz məhsulları bir elanda birləşdirmək olmaz."]}]]]}],"$L16","$L17","$L18","$L19","$L1a"],"$L1b","$L1c"]}],"$L1d"],null,"$L1e"]}],"p":"$@1f","v":null,"s":"$11"}}]]
