19:["$","p","3",{"children":[["$","strong",null,{"children":[2,".",4,"."]}]," ","Bir elan konkret əmlakı, əşyanı və ya birlikdə kirayəyə verilən dəsti təsvir etməlidir. Əlaqəsiz məhsulları bir elanda birləşdirmək olmaz."]}]
1a:["$","section","Təkrar elanlar və redaktə",{"id":"qayda-3","children":[["$","h2",null,{"children":[3,". ","Təkrar elanlar və redaktə"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[3,".",1,"."]}]," ","Eyni əmlak və ya əşya üçün təkrar aktiv və ya yoxlamada olan elan yaratma. Elanı silib yenidən yerləşdirməklə və ya başqa hesabdan istifadə etməklə limitdən yayınmaq olmaz."]}],["$","p","1",{"children":[["$","strong",null,{"children":[3,".",2,"."]}]," ","Qiymət, təsvir, şəkil və əlaqə məlumatlarında dəyişiklik üçün mövcud elanın “Redaktə et” seçimini istifadə et. Dəyişikliklər yenidən yoxlamaya göndərilir."]}],["$","p","2",{"children":[["$","strong",null,{"children":[3,".",3,"."]}]," ","Mövcud elanın məlumatlarını başqa əmlakın və ya əşyanın məlumatları ilə əvəz etmək olmaz. Redaktə elanı avtomatik irəli çəkmir."]}],["$","p","3",{"children":[["$","strong",null,{"children":[3,".",4,"."]}]," ","Artıq kirayəyə verilməyən və ya aktual olmayan elanı sil. Silinən elan geri qaytarılmır, hesab məlumatların qalır."]}]]]}]
1b:["$","section","Başlıq, qiymət və kirayə şərtləri",{"id":"qayda-4","children":[["$","h2",null,{"children":[4,". ","Başlıq, qiymət və kirayə şərtləri"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[4,".",1,"."]}]," ","Başlıq qısa, aydın və təklifə uyğun olmalıdır. Başlıqda telefon nömrəsi, reklam keçidləri, təkrarlanan açar sözlər və aldadıcı ifadələr yerləşdirmə."]}],["$","p","1",{"children":[["$","strong",null,{"children":[4,".",2,"."]}]," ","Qiyməti AZN ilə və hansı müddətə aid olduğunu göstərərək yaz. Real kirayə haqqını gizlədən şərti qiymət göstərmək olmaz."]}],["$","p","2",{"children":[["$","strong",null,{"children":[4,".",3,"."]}]," ","Depozit, minimum kirayə müddəti, çatdırılma və digər əlavə ödənişlər varsa, onları açıq qeyd et. Əşyanın məlum qüsurlarını və istifadə məhdudiyyətlərini gizlətmə."]}]]]}]
1c:["$","section","Şəkillər və əlaqə məlumatları",{"id":"qayda-5","children":[["$","h2",null,{"children":[5,". ","Şəkillər və əlaqə məlumatları"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[5,".",1,"."]}]," ","Elana əşyanı aydın göstərən 1–6 real şəkil əlavə et. JPG, PNG və WebP qəbul olunur; hər şəkil maksimum 5 MB ola bilər. Başqasının şəkillərindən icazəsiz istifadə etmə."]}],["$","p","1",{"children":[["$","strong",null,{"children":[5,".",2,"."]}]," ","İşlək e-poçt və istifadəsinə icazən olan telefon nömrəsi göstər. Əlaqə məlumatlarını bunun üçün ayrılmış xanalarda yaz; başqasına narahatlıq yaratmaq məqsədilə onun nömrəsini yerləşdirmək olmaz."]}],["$","p","2",{"children":[["$","strong",null,{"children":[5,".",3,"."]}]," ","Şəxsiyyət vəsiqəsi, bank kartının həssas məlumatları, PIN/CVV, şifrə və SMS kodlarını elanda və şəkillərdə paylaşma. Hesabına giriş məlumatlarını başqasına vermə."]}]]]}]
1d:["$","section","Yoxlama və şikayətlər",{"id":"qayda-6","children":[["$","h2",null,{"children":[6,". ","Yoxlama və şikayətlər"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[6,".",1,"."]}]," ","Yeni və redaktə edilmiş elanlar yoxlanılır. Qaydalara uyğun olmayan elan rədd edilə bilər; rədd səbəbi şəxsi kabinetdə göstərilir."]}],["$","p","1",{"children":[["$","strong",null,{"children":[6,".",2,"."]}]," ","Şübhəli elan barədə elan səhifəsindəki şikayət funksiyasından istifadə et. Səbəbi və araşdırmaya kömək edəcək məlumatları göstər."]}],["$","p","2",{"children":[["$","strong",null,{"children":[6,".",3,"."]}]," ","Qayda pozuntusu aşkarlandıqda düzəliş tələb oluna və ya elanın yayımı dayandırıla bilər. Təkrar və ciddi pozuntular hesabın məhdudlaşdırılması üçün əsas ola bilər."]}],["$","p","3",{"children":[["$","strong",null,{"children":[6,".",4,"."]}]," ","Şikayətə araşdırma əsasında baxılır. Qərarla razılaşmadıqda elan nömrəsini və izahını göstərərək yenidən baxılmasını istəyə bilərsən."]}]]]}]
1e:["$","section","Reklam xidmətləri və ödənişlər",{"id":"qayda-7","children":[["$","h2",null,{"children":[7,". ","Reklam xidmətləri və ödənişlər"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[7,".",1,"."]}]," ","VIP, Premium, irəli çəkmə və balans artırılması hazırda aktiv deyil. Paket və ödəniş üsulu seçimləri önbaxışdır; pul tutulmur və elanın sıralaması dəyişmir."]}],["$","p","1",{"children":[["$","strong",null,{"children":[7,".",2,"."]}]," ","Ödənişli xidmətlər aktivləşdirildikdə qiymət, müddət, tətbiq və geri qaytarma şərtləri ödənişdən əvvəl göstəriləcək. Reklam xidməti elan qaydalarını və yerləşdirmə limitlərini aradan qaldırmır."]}],["$","p","2",{"children":[["$","strong",null,{"children":[7,".",3,"."]}]," ","Kirayə razılaşması hazırda tərəflər arasında bağlanır. Əşyanı və qarşı tərəfi yoxlamadan beh göndərmə; qiymət, depozit, müddət, zərər və qaytarılma şərtlərini əvvəlcədən yazılı razılaşdır."]}]]]}]
1f:["$","section",null,{"id":"muddet-ve-limit","children":[["$","h2",null,{"children":"8. Elan müddəti və limit qaydaları"}],["$","p",null,{"children":[["$","strong",null,{"children":"8.1."}]," Təsdiqlənmiş elan 30 gün yayımda qalır. Müddət bitdikdə elan silinmir, kabinetdə «Müddəti bitib» bölməsinə keçir."]}],["$","p",null,{"children":[["$","strong",null,{"children":"8.2."}]," Hər kateqoriyada ayda 1 elan pulsuzdur. Pulsuz yer elan təsdiqlənəndə istifadə olunur və 30 gün sonra yenidən açılır. Rədd edilmiş elan limit sərf etmir, elanı silmək isə limiti geri qaytarmır."]}],["$","p",null,{"children":[["$","strong",null,{"children":"8.3."}]," Limit dolduqda elan yenə yerləşdirilə bilər: o «Ödəniş gözləyir» bölməsinə düşür və ödənişdən sonra yoxlamaya göndərilir."]}],["$","p",null,{"children":[["$","strong",null,{"children":"8.4."}]," Müddəti bitmiş və ya silinmiş elanı bərpa etmək pulsuz yer varsa pulsuzdur, yoxdursa ödənişlidir."]}],["$","p",null,{"children":[["$","strong",null,{"children":"8.5."}]," Ödəniş sistemi hələ qoşulmayıb: ödənişli addımlarda heç bir məbləğ tutulmur. Qiymətlər ödəniş aktivləşdirilməzdən əvvəl göstəriləcək."]}]]}]
