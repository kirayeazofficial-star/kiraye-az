18:["$","section","Başlıq, qiymət və kirayə şərtləri",{"id":"qayda-3","children":[["$","h2",null,{"children":[3,". ","Başlıq, qiymət və kirayə şərtləri"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[3,".",1,"."]}]," ","Başlıq qısa, aydın və təklifə uyğun olmalıdır. Başlıqda telefon nömrəsi, reklam keçidləri, təkrarlanan açar sözlər və aldadıcı ifadələr yerləşdirmə."]}],["$","p","1",{"children":[["$","strong",null,{"children":[3,".",2,"."]}]," ","Qiyməti AZN ilə və hansı müddətə aid olduğunu göstərərək yaz. Real kirayə haqqını gizlədən şərti qiymət göstərmək olmaz."]}],["$","p","2",{"children":[["$","strong",null,{"children":[3,".",3,"."]}]," ","Depozit, minimum kirayə müddəti, çatdırılma və digər əlavə ödənişlər varsa, onları açıq qeyd et. Əşyanın məlum qüsurlarını və istifadə məhdudiyyətlərini gizlətmə."]}]]]}]
19:["$","section","Şəkillər və əlaqə məlumatları",{"id":"qayda-4","children":[["$","h2",null,{"children":[4,". ","Şəkillər və əlaqə məlumatları"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[4,".",1,"."]}]," ","Elana əşyanı aydın göstərən real şəkillər əlavə et. Başqasının şəkillərindən icazəsiz istifadə etmə."]}],["$","p","1",{"children":[["$","strong",null,{"children":[4,".",2,"."]}]," ","İşlək e-poçt və istifadəsinə icazən olan telefon nömrəsi göstər. Başqasına narahatlıq yaratmaq məqsədilə onun nömrəsini yerləşdirmək olmaz."]}],["$","p","2",{"children":[["$","strong",null,{"children":[4,".",3,"."]}]," ","Şəxsiyyət vəsiqəsi, bank kartının həssas məlumatları, PIN/CVV, şifrə və SMS kodlarını elanda və şəkillərdə paylaşma."]}]]]}]
1a:["$","section","Yoxlama və şikayətlər",{"id":"qayda-5","children":[["$","h2",null,{"children":[5,". ","Yoxlama və şikayətlər"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[5,".",1,"."]}]," ","Qaydalara uyğun olmayan elan yayımlanmaya bilər və ya saytdan götürülə bilər."]}],["$","p","1",{"children":[["$","strong",null,{"children":[5,".",2,"."]}]," ","Şübhəli elan barədə elanın ünvanını və səbəbi bizə göndər. Şikayətə araşdırma əsasında baxılır."]}],["$","p","2",{"children":[["$","strong",null,{"children":[5,".",3,"."]}]," ","Təkrar və ciddi qayda pozuntuları elan sahibi ilə əməkdaşlığın dayandırılması üçün əsas ola bilər."]}]]]}]
