[\"Kirayə Al\",\"Kiraye Al\",\"kirayeal\"],\"url\":\"https://kirayeal.az\",\"logo\":\"https://kirayeal.az/icon-192.png\",\"email\":\"kirayeal.az@gmail.com\",\"telephone\":\"+994502191145\",\"sameAs\":[\"https://www.instagram.com/kirayeal.az/\",\"https://www.tiktok.com/@kirayeal.az\"]},{\"@type\":\"WebSite\",\"@id\":\"https://kirayeal.az/#website\",\"name\":\"kirayeal.az\",\"alternateName\":[\"Kirayə Al\",\"Kiraye Al az\"],\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://kirayeal.az/?q={search_term_string}#elanlar\",\"query-input\":\"required name=search_term_string\"},\"url\":\"https://kirayeal.az\",\"inLanguage\":\"az-AZ\",\"publisher\":{\"@id\":\"https://kirayeal.az/#organization\"}}]}"}}]]}]}]]}],"p":false,"v":null},"c":"$Q13"},"h":{"r":["$","$1","h",{"children":[null,["$","$L21",null,{"children":"$L22"}],["$","$L24",null,{"children":[["$","div",null,{"hidden":true,"children":["$","$25",null,{"name":"Next.Metadata","children":"$L26"}]}],null]}],null]}],"p":false,"v":null}},"m":"$undefined","G":["$27",[]],"S":true,"r":"$undefined","s":"$undefined","a":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"rKtcEObA7MfOCyLNUBX1T"}
