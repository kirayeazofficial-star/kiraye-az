15:[["children",{"s":"__PAGE__","h":512,"d":{"r":["$","$1","c",{"children":[[["$","$L11",null,{}],["$","main",null,{"className":"wrap prose","children":[["$","p",null,{"className":"eyebrow","children":"HÜQUQİ MƏLUMAT"}],["$","h1",null,{"children":"İstifadəçi razılaşması"}],["$","p",null,{"children":"Son yeniləmə: 30 oktyabr 2026"}],[["$","section","Ümumi şərtlər və terminlər",{"id":"bend-1","children":[["$","h2",null,{"children":[1,". ","Ümumi şərtlər və terminlər"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[1,".",1,"."]}]," ","Bu Razılaşma https://kirayeal.az saytından (bundan sonra — Sayt) istifadə şərtlərini müəyyən edir. Saytdan istifadə edən hər kəs bu Razılaşmanı qəbul etmiş sayılır."]}],["$","p","1",{"children":[["$","strong",null,{"children":[1,".",2,"."]}]," ","Sayt — kirayeal.az ünvanında yerləşən internet-resurs, onun dizaynı, məlumat bazası və Saytda yerləşdirilmiş bütün məlumatlardır."]}],["$","p","2",{"children":[["$","strong",null,{"children":[1,".",3,"."]}]," ","Administrasiya — Saytı idarə edən kirayeal.az administrasiyasıdır. Sayta dair hüquqlar Administrasiyaya məxsusdur."]}],["$","p","3",{"children":[["$","strong",null,{"children":[1,".",4,"."]}]," ","İstifadəçi — bu Razılaşmanı qəbul edib Saytdan istifadə edən istənilən şəxsdir. Şəxsi kabinet — İstifadəçinin elanlarını, mesajlarını və hesab ayarlarını idarə etdiyi bölmədir. Şəxsi hesab — yalnız Saytdakı ödənişli xidmətlər üçün istifadə olunan balansdır."]}],["$","p","4",{"children":[["$","strong",null,{"children":[1,".",5,"."]}]," ","Saytdan istifadə etməklə İstifadəçi bu Razılaşmaya, Elan yerləşdirmə qaydalarına və Məxfilik siyasətinə əməl etməyi öhdəsinə götürür. Razı olmadıqda Saytdan istifadəni dayandırmalıdır."]}]]]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c"],"$L1d"]}],"$L1e"],null,"$L1f"]}],"p":false,"v":null}}]]
