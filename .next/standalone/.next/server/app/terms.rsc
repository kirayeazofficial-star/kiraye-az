16:["$","section","Hesab və təhlükəsizlik",{"id":"bend-2","children":[["$","h2",null,{"children":[2,". ","Hesab və təhlükəsizlik"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[2,".",1,"."]}]," ","Elan yerləşdirmək və mesaj yazmaq üçün qeydiyyat tələb olunur. Qeydiyyatda düzgün ad, işlək e-poçt və telefon nömrəsi göstərilməlidir."]}],["$","p","1",{"children":[["$","strong",null,{"children":[2,".",2,"."]}]," ","Bir şəxsin yalnız bir hesabı ola bilər. Başqasının adından və ya başqasının məlumatları ilə hesab yaratmaq qadağandır."]}],["$","p","2",{"children":[["$","strong",null,{"children":[2,".",3,"."]}]," ","Şifrənin gizli saxlanmasına İstifadəçi özü cavabdehdir. Hesabda edilən bütün hərəkətlər həmin hesabın sahibinin hərəkəti sayılır. Hesaba icazəsiz giriş şübhəsi olduqda şifrəni dərhal dəyişin."]}],["$","p","3",{"children":[["$","strong",null,{"children":[2,".",4,"."]}]," ","Administrasiya qeydiyyat məlumatlarının düzgünlüyünü yoxlamaq və lazım olduqda təsdiq istəmək hüququna malikdir, lakin İstifadəçinin həqiqətən göstərdiyi şəxs olduğuna zəmanət vermir."]}]]]}]
17:["$","section","Elanlar və məzmun",{"id":"bend-3","children":[["$","h2",null,{"children":[3,". ","Elanlar və məzmun"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[3,".",1,"."]}]," ","Elanlar Elan yerləşdirmə qaydalarına uyğun yerləşdirilir. Elanın məzmununa (mətn, şəkil, qiymət, şərtlər) tam olaraq elan sahibi cavabdehdir."]}],["$","p","1",{"children":[["$","strong",null,{"children":[3,".",2,"."]}]," ","Elan yerləşdirməklə İstifadəçi təsdiq edir ki, əşyanı kirayəyə vermək hüququ var və şəkillərin istifadəsinə icazəsi var. İstifadəçi Administrasiyaya elanı və şəkilləri Saytda, axtarışda və Saytın reklamında göstərmək üçün pulsuz icazə verir."]}],["$","p","2",{"children":[["$","strong",null,{"children":[3,".",3,"."]}]," ","Qadağandır: qanuna zidd əşya və xidmətlər; saxta, aldadıcı və ya başqasının elanı; təhqiredici, ədəbsiz, nifrət oyadan məzmun; başqalarının şəxsi məlumatları; virus və zərərli keçidlər; spam və kütləvi eyni elanlar; elanda telefon nömrəsi və ya link yazmaqla qaydalardan yayınmaq."]}],["$","p","3",{"children":[["$","strong",null,{"children":[3,".",4,"."]}]," ","Administrasiya qaydalara uyğun olmayan elanı dərc etməmək, redaktə etmək, gizlətmək və ya silmək, həmçinin elanın göstərilmə müddətini dəyişmək hüququna malikdir."]}],["$","p","4",{"children":[["$","strong",null,{"children":[3,".",5,"."]}]," ","Kirayə razılaşması kirayə verən və kirayə götürən arasında birbaşa bağlanır. Sayt bu razılaşmanın tərəfi, vasitəçisi və ya zamini deyil."]}]]]}]
18:["$","section","Hesabın məhdudlaşdırılması",{"id":"bend-4","children":[["$","h2",null,{"children":[4,". ","Hesabın məhdudlaşdırılması"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[4,".",1,"."]}]," ","Qaydalar dəfələrlə və ya ciddi şəkildə pozulduqda (dələduzluq, saxta elanlar, təhqir, spam) Administrasiya hesabı xəbərdarlıqsız məhdudlaşdıra və ya bloklaya bilər."]}],["$","p","1",{"children":[["$","strong",null,{"children":[4,".",2,"."]}]," ","Bloklanmış İstifadəçi Administrasiyanın icazəsi olmadan yeni hesab aça və ya başqasının hesabından istifadə edə bilməz."]}]]]}]
19:["$","section","Ödənişli xidmətlər",{"id":"bend-5","children":[["$","h2",null,{"children":[5,". ","Ödənişli xidmətlər"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[5,".",1,"."]}]," ","Saytda ödənişli xidmətlər təklif oluna bilər: İrəli çək, VIP, Premium, limitdən artıq elan və elanın bərpası. Qiymətlər və şərtlər ödənişdən əvvəl göstərilir."]}],["$","p","1",{"children":[["$","strong",null,{"children":[5,".",2,"."]}]," ","Ödənişli xidmət elanın qaydalara uyğunluğunu yoxlamadan azad etmir. Qaydaları pozan elan silindikdə və ya gizlədildikdə ödənilmiş məbləğ qaytarılmır."]}],["$","p","2",{"children":[["$","strong",null,{"children":[5,".",3,"."]}]," ","Aktivləşdirilmiş xidmət üçün ödəniş qaytarılmır. Texniki səbəbdən xidmət göstərilmədikdə məsələyə fərdi qaydada baxılır."]}],["$","p","3",{"children":[["$","strong",null,{"children":[5,".",4,"."]}]," ","Şəxsi hesabdakı vəsait yalnız Saytdakı xidmətlər üçün istifadə olunur və nağd pula çevrilmir."]}]]]}]
1a:["$","section","Bildirişlər və əlaqə",{"id":"bend-6","children":[["$","h2",null,{"children":[6,". ","Bildirişlər və əlaqə"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[6,".",1,"."]}]," ","Sayt İstifadəçiyə e-poçtla xidməti məktublar göndərə bilər: təsdiq kodları, elanın təsdiqi və ya rəddi, yeni mesajlar haqqında bildirişlər."]}],["$","p","1",{"children":[["$","strong",null,{"children":[6,".",2,"."]}]," ","İstifadəçinin e-poçt və telefon nömrəsi reklam məqsədilə üçüncü şəxslərə verilmir. Qanunla tələb olunduqda (məsələn, dələduzluq və ya cinayət araşdırması zamanı) məlumatlar səlahiyyətli dövlət orqanlarına təqdim edilə bilər."]}],["$","p","2",{"children":[["$","strong",null,{"children":[6,".",3,"."]}]," ","Administrasiya ilə əlaqə: kirayeal.az@gmail.com, +994 50 219 11 45."]}]]]}]
1b:["$","section","Məsuliyyətin məhdudlaşdırılması",{"id":"bend-7","children":[["$","h2",null,{"children":[7,". ","Məsuliyyətin məhdudlaşdırılması"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[7,".",1,"."]}]," ","Administrasiya elanların düzgünlüyünü, əşyanın vəziyyətini, tərəflərin etibarlılığını və kirayə razılaşmasının icrasını yoxlamır və bunlara görə cavabdeh deyil."]}],["$","p","1",{"children":[["$","strong",null,{"children":[7,".",2,"."]}]," ","İstifadəçilər arasında yaranan mübahisələr (qiymət, depozit, zərər, qaytarılma) tərəflər arasında həll edilir. Administrasiya bu cür itki və zərərlərə görə məsuliyyət daşımır."]}],["$","p","2",{"children":[["$","strong",null,{"children":[7,".",3,"."]}]," ","Administrasiya Saytın fasiləsiz işləməsinə çalışır, lakin texniki nasazlıq, üçüncü tərəf xidmətlərinin (internet, ödəniş sistemi) problemləri və onlardan yaranan nəticələrə görə məsuliyyət daşımır."]}]]]}]
1c:["$","section","Yekun müddəalar",{"id":"bend-8","children":[["$","h2",null,{"children":[8,". ","Yekun müddəalar"]}],[["$","p","0",{"children":[["$","strong",null,{"children":[8,".",1,"."]}]," ","Bu Razılaşmaya Azərbaycan Respublikasının qanunvericiliyi tətbiq olunur. Mübahisələr əvvəlcə danışıqlar yolu ilə, razılıq olmadıqda qanunvericiliyə uyğun həll edilir."]}],["$","p","1",{"children":[["$","strong",null,{"children":[8,".",2,"."]}]," ","Administrasiya bu Razılaşmanı birtərəfli qaydada dəyişə bilər. Yeni redaksiya Saytda dərc olunduğu andan qüvvəyə minir."]}],["$","p","2",{"children":[["$","strong",null,{"children":[8,".",3,"."]}]," ","Razılaşmanın hər hansı bəndinin etibarsız sayılması digər bəndlərin qüvvəsinə təsir etmir."]}]]]}]
