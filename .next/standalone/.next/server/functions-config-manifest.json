{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/|favicon|icon|apple-touch|manifest|robots|sitemap|.*\\.[a-z0-9]+$).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/|favicon|icon|apple-touch|manifest|robots|sitemap|.*\\.[a-z0-9]+$).*)"
        }
      ]
    },
    "/api/account/avatar": {},
    "/api/account/profile": {},
    "/api/admin/banners": {},
    "/api/auth/recovery-check": {},
    "/api/listing-view": {},
    "/api/stores": {}
  }
}